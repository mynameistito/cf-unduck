{
  "name": "cf-unduck",
  "private": false,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "portless cf-unduck vite dev",
    "build": "vite build && tsgo --noEmit",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "fetch-bangs": "bun run scripts/fetch-bangs.ts",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.168.11",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260525.1",
    "@vitejs/plugin-react": "^6.0.2",
    "lefthook": "^2.1.8",
    "react-grab": "^0.1.37",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "ultracite": "7.7.0",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.94.0"
  },
  "overrides": {
    "ws": ">=8.20.1"
  }
}
