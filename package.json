{
  "name": "cf-unduck",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "portless cf-unduck vite dev",
    "build": "vite build && tsgo --noEmit",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "fetch-bangs": "bun run scripts/fetch-bangs.ts",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260629.1",
    "@vitejs/plugin-react": "^6.0.3",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "react-grab": "^0.1.47",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "ultracite": "7.8.3",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.105.0"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "ws": ">=8.21.0"
  }
}
