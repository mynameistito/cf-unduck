{
  "name": "cf-unduck",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "portless cf-unduck vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "fetch-bangs": "bun run scripts/fetch-bangs.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.18",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react-grab": "^0.1.50",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "7.9.4",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.116.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "ws": ">=8.21.0"
  }
}
