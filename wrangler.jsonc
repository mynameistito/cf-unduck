{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-unduck",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "routes": [
    {
      "pattern": "search.mynameistito.com",
      "custom_domain": true
    }
  ]
}
