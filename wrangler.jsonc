{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-unduck",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "routes": [
    {
      "pattern": "search.mynameistito.com",
      "custom_domain": true
    }
  ]
}
